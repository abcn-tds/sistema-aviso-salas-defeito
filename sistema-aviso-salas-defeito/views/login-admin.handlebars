<div class="login-container">

    <h1>👨‍💼 Login do Administrador</h1>

    {{#if erro}}
        <p class="erro">{{erro}}</p>
    {{/if}}

    <form action="/login/admin" method="POST">

        <label>E-mail:</label>
        <input type="email" name="email" required>

        <label>Senha:</label>
        <input type="password" name="senha" required>

        <button type="submit">Entrar</button>

    </form>

    <br>

    <a href="/">← Voltar</a>

</div>