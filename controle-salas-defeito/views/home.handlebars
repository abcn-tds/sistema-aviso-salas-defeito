<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <title>Controle de Salas com Defeito</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <h1>🏫 Sistema de Controle de Salas com Defeito</h1>

    <hr>

    <h2>Olá, {{usuario.nome}}! 👋</h2>

    <h3>Menu</h3>

    <ul>

        {{#if (eq usuario.tipo "aluno")}}

            <li>
                <a href="/salas/cadastrar">
                    ➕ Cadastrar Sala
                </a>
            </li>

            <li>
                <a href="/defeitos/cadastrar">
                    🛠️ Cadastrar Defeito
                </a>
            </li>

        {{else}}

            <li>
                <a href="/salas">
                    📋 Listar Salas
                </a>
            </li>

            <li>
                <a href="/defeitos">
                    🛠️ Listar Defeitos
                </a>
            </li>

        {{/if}}

        <li>
            <a href="/logout">🚪 Sair</a>
        </li>

    </ul>

</body>

</html>