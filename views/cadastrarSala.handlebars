<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar Sala</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Cadastrar Sala</h1>

    <form action="/salas/cadastrar" method="POST">

        <label>Número da Sala:</label><br>
        <input type="text" name="numero" required><br><br>

        <label>Bloco:</label><br>
        <input type="text" name="bloco" required><br><br>

        <label>Responsável:</label><br>
        <input type="text" name="responsavel" required><br><br>

        <button type="submit">Cadastrar</button>

    </form>

    <br>

    <a href="/">⬅ Voltar ao início</a>

</body>

</html>