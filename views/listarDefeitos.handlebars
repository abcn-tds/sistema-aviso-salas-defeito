<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Lista de Defeitos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Defeitos Cadastrados</h1>

    <a href="/defeitos/cadastrar">
        <button>Novo Defeito</button>
    </a>

    <hr>

    {{#each defeitos}}

    <div>

        <h3>Sala: {{sala}}</h3>

        <p><strong>Tipo:</strong> {{tipo}}</p>

        <p><strong>Descrição:</strong> {{descricao}}</p>

        <p><strong>Status:</strong> {{status}}</p>

        <a href="/defeitos/editar/{{id}}">
            <button>Editar</button>
        </a>

        <form action="/defeitos/excluir/{{id}}" method="POST">
            <button type="submit">Excluir</button>
        </form>

        <hr>

    </div>

    {{else}}

    <h3>Nenhum defeito cadastrado.</h3>

    {{/each}}

    <br>

    <a href="/">Voltar ao início</a>

</body>

</html>