<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Lista de Salas</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>Salas Cadastradas</h1>

    <a href="/salas/cadastrar">
        <button>Nova Sala</button>
    </a>

    <hr>

    {{#each salas}}

    <div>

        <h3>Sala {{numero}}</h3>

        <p><strong>Bloco:</strong> {{bloco}}</p>

        <p><strong>Responsável:</strong> {{responsavel}}</p>

        <a href="/salas/editar/{{id}}">
            <button>Editar</button>
        </a>

        <form action="/salas/excluir/{{id}}" method="POST">

            <button type="submit">Excluir</button>

        </form>

        <hr>

    </div>

    {{else}}

    <h3>Nenhuma sala cadastrada.</h3>

    {{/each}}

    <a href="/">Voltar ao início</a>

</body>

</html>